{
  "description": "Exercise firmware retract with E movement but no Z lift.",
  "config": {},
  "actions": [
    { "kind": "submit_gcode", "command": "G21" },
    { "kind": "submit_gcode", "command": "G90" },
    { "kind": "submit_gcode", "command": "M207 S2 F600 Z0" },
    { "kind": "submit_gcode", "command": "M208 S0 F300" },
    { "kind": "submit_gcode", "command": "G10 S0" },
