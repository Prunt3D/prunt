{
  "description": "Cancel a G-code file partway through a long move, then pause and resume the idle machine and send a new move. The pause plan starts by resetting the position to the pause position, so the step generator must hand it the position the machine stopped at after the cancel. Handing it the origin instead gives the machine a false origin that persists after the resume.",
  "config": {},
  "actions": [
    { "kind": "submit_gcode", "command": "G28" },
    { "kind": "wait_idle", "timeout_s": 5.0 },
    { "kind": "submit_gcode_file", "commands": ["G1 X150 F600"] },
    { "kind": "wait_for_motion", "timeout_s": 10.0 },
    { "kind": "advance_by_s", "duration_s": 1.0 },
    { "kind": "cancel_at_s", "time_s": 0.0 },
    { "kind": "wait_idle", "timeout_s": 10.0 },
    { "kind": "pause", "timeout_s": 8.0 },
    { "kind": "resume", "timeout_s": 8.0 },
    { "kind": "submit_gcode", "command": "G1 X60 F600" },
    { "kind": "wait_idle", "timeout_s": 20.0 }
  ],
  "expect": {
    "final_position": { "X": 60.0, "Y": 0.0, "Z": 0.0, "E": 0.0 },
    "position_tolerance": 0.05,
    "sample_position_reaches": { "X": 5.0 },
    "max_sample_delta": { "X": 0.5, "Y": 0.01, "Z": 0.01, "E": 0.01 },
    "max_position_offset": { "X": 0.001, "Y": 0.001, "Z": 0.001, "E": 0.001 },
    "event_counts": { "pause": 4, "cancel": 2 },
    "event_order": [
      { "kind": "cancel", "label": "cancel_requested" },
      { "kind": "cancel", "label": "cancel_completed" },
      { "kind": "pause", "label": "pause_requested" },
      { "kind": "pause", "label": "paused" },
      { "kind": "pause", "label": "resume_requested" },
      { "kind": "pause", "label": "resumed" }
    ]
  }
}
