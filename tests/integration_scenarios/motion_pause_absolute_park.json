{
  "description": "Exercise absolute pause-park config loading, validation, and save conversion.",
  "config": {
    "Motion": {
      "Pause_Park": {
        "Kind": {
          "Selected": "Absolute_Park_Move",
          "Children": {
            "Absolute_Park_Move": {
              "Absolute_Park_Move": {
                "Out_Of_Bounds_Behavior": "CLIP_TO_BOUNDS",
                "X_Position": 10.0,
                "Y_Position": 5.0,
                "Z_Target": {
                  "Kind": {
                    "Selected": "Absolute_Z_Position",
                    "Children": {
                      "Absolute_Z_Position": {
                        "Z_Position": 0.0,
                        "Avoid_Lowering_Z": true
                      }
                    }
                  }
                },
                "E_Offset": -2.0,
                "Feedrate": 180.0,
                "Return_Feedrate": 180.0
              }
            }
          }
        }
      }
    }
  },
  "actions": [
    { "kind": "submit_gcode", "command": "G21" },
    { "kind": "submit_gcode", "command": "G90" },
    { "kind": "submit_gcode", "command": "G1 X60 Y30 Z1 F600" },
    { "kind": "wait_for_motion", "timeout_s": 60.0 },
    { "kind": "advance_to_s", "time_s": 1.0 },
    { "kind": "pause" },
    { "kind": "advance_by_s", "duration_s": 6.0 },
    { "kind": "resume" },
    { "kind": "wait_idle", "timeout_s": 30.0 },
    { "kind": "submit_gcode", "command": "M500" },
    { "kind": "wait_idle", "timeout_s": 5.0 }
